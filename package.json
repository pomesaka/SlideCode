{
  "name": "slidecode",
  "version": "0.1.0",
  "description": "AI-friendly React component library for building presentations",
  "keywords": ["react", "presentation", "slides", "components", "svg-charts", "ai"],
  "repository": {
    "type": "git",
    "url": "https://github.com/pomesaka/SlideCode.git"
  },
  "homepage": "https://github.com/pomesaka/SlideCode",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.0.0"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "preview": "vite preview --config demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "bun run build",
    "version": "bash scripts/version-changelog.sh"
  }
}
